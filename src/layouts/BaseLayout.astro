---
import { ClientRouter } from "astro:transitions";
import SpeedInsights from "@vercel/speed-insights/astro";
import "../styles/global.css";
import "../styles/layout.css";
import GlobeBackground from "../components/GlobeBackground.astro";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Personal website of ncwade - Software engineer exploring technology, code, and ideas.",
} = Astro.props;

// Normalize path by removing trailing slash (except for root "/")
const rawPath = Astro.url.pathname;
const currentPath =
    rawPath.endsWith("/") && rawPath !== "/" ? rawPath.slice(0, -1) : rawPath;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#0a0a0f" />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />

        <!-- Performance hints -->
        <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
        <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <!-- Favicon -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <SpeedInsights />

        <!-- Fonts - reduced weights for performance -->
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
            rel="stylesheet"
        />

        <title>{title}</title>
        <ClientRouter />
    </head>
    <body>
        <GlobeBackground />
        <script>
            import "../scripts/globe.ts";
        </script>
        <script is:inline>
            if (!window.__ncwadeTransitionsInitialized) {
                window.__ncwadeTransitionsInitialized = true;

                // Navigation order for directional transitions (matches header nav)
                const navOrder = [
                    "/",
                    "/about",
                    "/experience",
                    "/contact",
                    "/principles",
                ];

                function normalizePath(path) {
                    return path === "/" ? "/" : path.replace(/\/$/, "");
                }

                function getPageIndex(path) {
                    return navOrder.indexOf(normalizePath(path));
                }

                function isModifiedEvent(event) {
                    return (
                        event.metaKey ||
                        event.ctrlKey ||
                        event.shiftKey ||
                        event.altKey
                    );
                }

                // Prevent redundant navigation when clicking the current page link.
                document.addEventListener(
                    "click",
                    (event) => {
                        if (
                            event.defaultPrevented ||
                            event.button !== 0 ||
                            isModifiedEvent(event)
                        ) {
                            return;
                        }

                        if (!(event.target instanceof Element)) {
                            return;
                        }

                        const anchor = event.target.closest("a[href]");
                        if (!anchor) {
                            return;
                        }

                        if (
                            anchor.target === "_blank" ||
                            anchor.hasAttribute("download")
                        ) {
                            return;
                        }

                        const toUrl = new URL(anchor.href, window.location.href);
                        const currentUrl = new URL(window.location.href);

                        if (toUrl.origin !== currentUrl.origin) {
                            return;
                        }

                        const samePath =
                            normalizePath(toUrl.pathname) ===
                            normalizePath(currentUrl.pathname);
                        const sameSearch = toUrl.search === currentUrl.search;
                        const sameHash = toUrl.hash === currentUrl.hash;

                        if (samePath && sameSearch && sameHash) {
                            event.preventDefault();
                        }
                    },
                    { capture: true },
                );

                // Override Astro's transition direction based on nav order.
                document.addEventListener("astro:before-preparation", (e) => {
                    const fromPath = normalizePath(window.location.pathname);
                    const toPath = normalizePath(new URL(e.to).pathname);

                    // Same-route navigation should be a no-op.
                    if (fromPath === toPath) {
                        return;
                    }

                    const fromIndex = getPageIndex(fromPath);
                    const toIndex = getPageIndex(toPath);

                    // Only override if both pages are in our nav order.
                    if (fromIndex !== -1 && toIndex !== -1) {
                        if (toIndex > fromIndex) {
                            e.direction = "forward";
                        } else if (toIndex < fromIndex) {
                            e.direction = "back";
                        }
                    }
                });
            }
        </script>

        <div class="page-wrapper" transition:animate="none">
            <header class="site-header">
                <nav class="nav container">
                    <a href="/" class="logo">
                        <span class="logo-text">Nick Wade</span>
                    </a>
                    <ul class="nav-links">
                        <li>
                            <a
                                href="/"
                                class={currentPath === "/" ? "active" : ""}
                                aria-current={currentPath === "/" ? "page" : undefined}
                                >Home</a
                            >
                        </li>
                        <li>
                            <a
                                href="/about"
                                class={currentPath === "/about" ? "active" : ""}
                                aria-current={currentPath === "/about"
                                    ? "page"
                                    : undefined}
                                >About</a
                            >
                        </li>
                        <li>
                            <a
                                href="/experience"
                                class={currentPath === "/experience"
                                    ? "active"
                                    : ""}
                                aria-current={currentPath === "/experience"
                                    ? "page"
                                    : undefined}>Experience</a
                            >
                        </li>
                        <li>
                            <a
                                href="/contact"
                                class={currentPath === "/contact"
                                    ? "active"
                                    : ""}
                                aria-current={currentPath === "/contact"
                                    ? "page"
                                    : undefined}>Contact</a
                            >
                        </li>
                        <li>
                            <a
                                href="/principles"
                                class={currentPath === "/principles"
                                    ? "active"
                                    : ""}
                                aria-current={currentPath === "/principles"
                                    ? "page"
                                    : undefined}>Principles</a
                            >
                        </li>
                    </ul>
                </nav>
            </header>

            <main class="main-content" transition:name="main-content">
                <slot />
            </main>

            <footer class="site-footer">
                <div class="container">
                    <div class="footer-content">
                        <div class="footer-copy text-muted">
                            &copy; {new Date().getFullYear()} Nick Wade.
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </body>
</html>
